          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "dataset": "https://<your-tenant>.sharepoint.com/sites/ContosoIT",
              "table": "52285274-a93b-4986-b5fa-384c6fcc9598"
            },
            "host": {
