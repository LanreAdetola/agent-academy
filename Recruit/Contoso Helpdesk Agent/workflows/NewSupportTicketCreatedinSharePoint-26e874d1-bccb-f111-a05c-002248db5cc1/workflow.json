          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "Copilot": "cts_itHelpDeskAssistant",
              "body/message": "New Support Ticket Created in SharePoint:\n@{concat(\u0027Submitted By Name: \u0027, item()?[\u0027Author/DisplayName\u0027], \u0027\\nSubmitted By Email: \u0027, item()?[\u0027Author/Email\u0027], \u0027\\nTitle: \u0027, item()?[\u0027Title\u0027], \u0027\\nIssue Description: \u0027, item()?[\u0027Description\u0027], \u0027\\nPriority: \u0027, item()?[\u0027Priority/Value\u0027], \u0027\\nTicket ID : \u0027, item()?[\u0027ID\u0027])}\n\nUse the \u0027Acknowledge SharePoint Ticket\u0027 tool to generate the email body automatically and respond.\n\nIMPORTANT: Do not wait for any user input. Work completely autonomously."
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_microsoftcopilotstudio",
              "operationId": "ExecuteCopilot",
              "connectionName": "shared_microsoftcopilotstudio"
